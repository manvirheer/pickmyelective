# ============================================
# PickMyElective Docker Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.docker.example .env

# ============================================
# PostgreSQL Database (Required)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=pickmyelective

# ============================================
# JWT Authentication (Required)
# ============================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ============================================
# Email Service - Resend (Required for auth)
# ============================================
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# RAG Service - AI APIs (Required)
# ============================================
# OpenAI API key for embeddings
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key

# Google API key for Gemini LLM
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key

# ============================================
# Optional Configuration
# ============================================
# ChromaDB collection name (default: courses_1264)
COLLECTION_NAME=courses_1264

# ============================================
# Frontend Configuration
# ============================================
# API URL for frontend to connect to backend
# For local Docker: http://localhost:8080
# For production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8080

# ============================================
# Backend Configuration
# ============================================
# CORS allowed origins (comma-separated)
# Must include your frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:80

# Spring profile (leave empty for development, set to 'prod' for production)
# Production profile enables: ddl-auto=validate, no SQL logging, stricter actuator
SPRING_PROFILES_ACTIVE=
